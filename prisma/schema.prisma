generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum ItemType {
  SERVICE
  PRODUCT
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELED
}

enum PaymentProvider {
  MERCADO_PAGO
  MANUAL
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  CASH
  DEBIT_CARD
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELED
}

enum TimelineEventType {
  ORDER_CREATED
  ITEM_ADDED
  ITEM_REMOVED
  DISCOUNT_APPLIED
  PIX_GENERATED
  PIX_APPROVED
  PIX_CANCELED
  PAYMENT_REJECTED
  ORDER_CLOSED
  ORDER_CANCELED
}

// ─── Models ────────────────────────────────────────────────────────────────

model Barbershop {
  id            String           @id @default(uuid())
  name          String
  address       String
  description   String
  imageUrl      String
  phones        String[]
  latitude      Float?
  longitude     Float?
  googleMapsUrl String?

  items         BarbershopItem[]
  bookings      Booking[]
  workingHours  WorkingHours[]
  blockedTimes  BlockedTime[]
  orders        Order[]
  cashRegisters CashRegister[]
  reviews       Review[]
}

model BarbershopItem {
  id                String          @id @default(uuid())
  barbershopId      String
  barbershop        Barbershop      @relation(fields: [barbershopId], references: [id])
  name              String
  description       String?
  imageUrl          String?
  type              ItemType        @default(SERVICE)
  priceInCents      Int
  costInCents       Int?
  durationInMinutes Int             @default(30)
  stockQuantity     Int?
  minimumStock      Int?
  commissionType    CommissionType?
  commissionValue   Int?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt

  bookings   Booking[]
  orderItems OrderItem[]

  @@index([barbershopId, type, isActive])
  @@index([barbershopId, isActive])
  @@map("BarbershopService")
}

model Booking {
  id           String         @id @default(uuid())
  serviceId    String
  service      BarbershopItem @relation(fields: [serviceId], references: [id])
  barbershopId String
  barbershop   Barbershop     @relation(fields: [barbershopId], references: [id])
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  date         DateTime       @db.Timestamptz
  endDate      DateTime?      @db.Timestamptz
  cancelled    Boolean        @default(false)
  cancelledAt  DateTime?      @db.Timestamptz

  order  Order?
  review Review?

  // Partial unique index enforced at DB level (Prisma @@unique doesn't support WHERE clauses).
  // Must exist in Supabase: CREATE UNIQUE INDEX IF NOT EXISTS "booking_active_slot_unique"
  //   ON "Booking" ("barbershopId", "date") WHERE "cancelled" = false;
  @@index([barbershopId, date])
  @@index([userId])
}

model Order {
  id              String      @id @default(uuid())
  barbershopId    String
  barbershop      Barbershop  @relation(fields: [barbershopId], references: [id])
  bookingId       String?     @unique
  booking         Booking?    @relation(fields: [bookingId], references: [id])
  customerId      String
  customer        User        @relation("CustomerOrders", fields: [customerId], references: [id])
  status          OrderStatus @default(OPEN)
  subtotalInCents Int         @default(0)
  discountInCents Int         @default(0)
  totalInCents    Int         @default(0)
  notes           String?
  createdAt       DateTime    @default(now())
  closedAt        DateTime?   @db.Timestamptz

  items    OrderItem[]
  payments Payment[]
  timeline OrderTimelineEvent[]

  @@index([barbershopId, status])
  @@index([barbershopId, createdAt])
  @@index([customerId])
}

model OrderItem {
  id                 String         @id @default(uuid())
  orderId            String
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId             String
  item               BarbershopItem @relation(fields: [itemId], references: [id])
  itemType           ItemType
  quantity           Int            @default(1)
  unitPriceInCents   Int
  professionalId     String?
  professional       User?          @relation("ProfessionalOrderItems", fields: [professionalId], references: [id])
  commissionSnapshot Json?
  totalInCents       Int

  @@index([orderId])
  @@index([itemId])
}

model Payment {
  id                       String          @id @default(uuid())
  orderId                  String
  order                    Order           @relation(fields: [orderId], references: [id])
  provider                 PaymentProvider
  method                   PaymentMethod
  status                   PaymentStatus   @default(PENDING)
  externalPaymentId        String?         @unique
  qrCode                   String?         @db.Text
  qrCodeBase64             String?         @db.Text
  pixCopyPaste             String?         @db.Text
  transactionAmountInCents Int
  paidAmountInCents        Int?
  metadata                 Json?
  webhookRaw               Json?
  createdAt                DateTime        @default(now())
  paidAt                   DateTime?       @db.Timestamptz

  @@index([orderId])
  @@index([externalPaymentId])
  @@index([status, provider])
}

model CashRegister {
  id                   String     @id @default(uuid())
  barbershopId         String
  barbershop           Barbershop @relation(fields: [barbershopId], references: [id])
  openedAt             DateTime   @default(now()) @db.Timestamptz
  closedAt             DateTime?  @db.Timestamptz
  initialAmountInCents Int
  finalAmountInCents   Int?
  differenceInCents    Int?
  openedById           String
  openedBy             User       @relation("CashOpenedBy", fields: [openedById], references: [id])
  closedById           String?
  closedBy             User?      @relation("CashClosedBy", fields: [closedById], references: [id])
  notes                String?

  @@index([barbershopId, openedAt])
}

model Review {
  id           String     @id @default(uuid())
  bookingId    String     @unique
  booking      Booking    @relation(fields: [bookingId], references: [id])
  customerId   String
  customer     User       @relation("CustomerReviews", fields: [customerId], references: [id])
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  rating       Int
  comment      String?
  approved     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([barbershopId, approved])
  @@index([customerId])
}

model OrderTimelineEvent {
  id        String             @id @default(uuid())
  orderId   String
  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      TimelineEventType
  message   String
  metadata  Json?
  createdAt DateTime           @default(now())
  createdBy String?

  @@index([orderId, createdAt])
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("USER")
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  sessions               Session[]
  accounts               Account[]
  bookings               Booking[]
  pushSubscriptions      PushSubscription[]
  orders                 Order[]          @relation("CustomerOrders")
  reviewsGiven           Review[]         @relation("CustomerReviews")
  cashRegistersOpened    CashRegister[]   @relation("CashOpenedBy")
  cashRegistersClosed    CashRegister[]   @relation("CashClosedBy")
  professionalOrderItems OrderItem[]      @relation("ProfessionalOrderItems")

  @@unique([email])
  @@map("user")
}

model WorkingHours {
  id           String     @id @default(uuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  dayOfWeek    Int
  openTime     String
  closeTime    String
  isOpen       Boolean    @default(true)

  @@unique([barbershopId, dayOfWeek])
}

model BlockedTime {
  id           String     @id @default(uuid())
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  startDate    DateTime   @db.Timestamptz
  endDate      DateTime   @db.Timestamptz
  reason       String?
  createdAt    DateTime   @default(now())

  @@index([barbershopId, startDate, endDate])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscription")
}
